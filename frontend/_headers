# _headers — Cloudflare Pages security headers

# ── Global headers (all routes) ──────────────────────────────────────────────
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://fonts.cdnfonts.com; font-src https://fonts.gstatic.com https://cdnjs.cloudflare.com https://fonts.cdnfonts.com; img-src 'self' data: https: blob:; connect-src 'self' https://api.arraffi.com https://challenges.cloudflare.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.arraffi.com;

# ── MIME type enforcement ─────────────────────────────────────────────────────
/*.html
  Content-Type: text/html; charset=UTF-8

/*.css
  Content-Type: text/css; charset=UTF-8

/*.js
  Content-Type: application/javascript; charset=UTF-8

/*.json
  Content-Type: application/json; charset=UTF-8

# ── Stricter CSP for admin panel (no Turnstile needed) ───────────────────────
/admin.html
  X-Robots-Tag: noindex, nofollow
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://api.arraffi.com https://cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self';

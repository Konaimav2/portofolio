# _headers — Cloudflare Pages security headers

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-AyzaFU+chrkTgcTYfdue9kOc04vpbPpcfu/POqBIvag=' 'sha256-q1XkErwUINPlWWWHtK4qYUTIjdpTN0BGJvXk5kIYZDs=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://fonts.cdnfonts.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://fonts.cdnfonts.com; img-src 'self' data: blob: https://banquet.arraffi.com; media-src 'self' blob: https://banquet.arraffi.com; connect-src 'self' https://api.arraffi.com https://challenges.cloudflare.com https://cloudflareinsights.com https://banquet.arraffi.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.arraffi.com; frame-ancestors 'none'; upgrade-insecure-requests;

/*.html
  Content-Type: text/html; charset=UTF-8

/*.css
  Content-Type: text/css; charset=UTF-8

/*.js
  Content-Type: application/javascript; charset=UTF-8

/*.json
  Content-Type: application/json; charset=UTF-8

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, max-age=0, must-revalidate

/id/
  Cache-Control: public, max-age=0, must-revalidate

/admin
  X-Robots-Tag: noindex, nofollow

/admin.html
  X-Robots-Tag: noindex, nofollow

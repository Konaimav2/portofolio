**/.env
**/.env.local
**/.env.*.local

# ── Wrangler / Cloudflare ──
.wrangler/

# ── Node (if you ever add tooling) ──
node_modules/
npm-debug.log*

# ── OS junk ──
.DS_Store
Thumbs.db

# ── Editor ──
.vscode/
.idea/
*.swp
*.swo

# ── AI Agent Skills (never push AI context to public repo) ──
.agent/
.agents/


# ─────────────────────────────────────────────────────────
# backend/.env.example — Copy this to .env and fill in values
# NEVER commit .env — it is in .gitignore
# ─────────────────────────────────────────────────────────

# MySQL connection string
# On VPS, use 127.0.0.1 (local) instead of the public IP
DATABASE_URL="mysql://portfolio:<your_db_password>@127.0.0.1:3306/portfolio"

# SMTP credentials
SMTP_HOST="smail.omori.my.id"
SMTP_PORT="2525"
SMTP_USER="smtp@mail.arraffi.my.id"
SMTP_PASS="<your_smtp_password>"
# SMTP_FROM must match SMTP_USER — mail server enforces sender ownership
SMTP_FROM="smtp@mail.arraffi.my.id"

# Admin panel password — use a STRONG password in production (min 16 chars)
ADMIN_PASSWORD="<strong_random_password_here>"

# Set to "production" on VPS to enable strict TLS for SMTP
NODE_ENV="production"

# API server port (must match Nginx proxy_pass)
PORT=3001

# Copy this file to backend/.env and fill in local values.
# Never commit backend/.env.

DATABASE_URL="mysql://<db_user>:<db_password>@<db_host>:3306/<db_name>"
ADMIN_PASSWORD="<strong_admin_password>"
TURNSTILE_SECRET="<cloudflare_turnstile_secret>"
NODE_ENV="development"
PORT=3001

# Optional in local dev. Required in production for avatar uploads to Cloudflare R2.
R2_ACCOUNT_ID="<cloudflare_account_id>"
R2_ACCESS_KEY_ID="<r2_access_key_id>"
R2_SECRET_ACCESS_KEY="<r2_secret_access_key>"
R2_BUCKET="<r2_bucket_name>"
R2_PUBLIC_URL="https://<avatar_public_domain>"
BUCKET_URL="https://<account_id>.r2.cloudflarestorage.com/<bucket_name>"
BUCKET_API_TOKEN="<cloudflare_api_token>"
R2_URL="https://pub-<hash>.r2.dev"

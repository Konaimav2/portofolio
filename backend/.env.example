NODE_ENV=development
PORT=3001
DATABASE_URL=mysql://portfolio_user:replace-me@db.example.invalid:3306/portfolio
DB_SSL_CA_FILE=/absolute/path/to/mysql-ca.pem
ADMIN_PASSWORD=replace-with-16-plus-byte-password
# Optional Telegram moderation notifications. Leave both empty to disable.
# Optional positive decimal Telegram user ID; the bot will mention this account on each comment notification.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_USER_ID=
TURNSTILE_SECRET=replace-with-turnstile-secret
TURNSTILE_HOSTNAMES=localhost,arraffi.com,www.arraffi.com
PUBLIC_ORIGINS=http://127.0.0.1:5500,http://127.0.0.1:5501,https://arraffi.com,https://www.arraffi.com
ADMIN_ORIGINS=http://127.0.0.1:5500,http://127.0.0.1:5501,https://arraffi.com
IMAGE_SOURCE_HOSTS=banquet.arraffi.com,cdn.example.invalid
R2_ACCOUNT_ID=replace-with-account-id
R2_ACCESS_KEY_ID=replace-with-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-secret-access-key
R2_BUCKET=replace-with-bucket-name
R2_PUBLIC_URL=https://assets.example.invalid
BUCKET_URL=https://account-id.r2.cloudflarestorage.com/bucket-name
